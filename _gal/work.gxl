extern mod sys_ops { path = "./mods" ; }  ;
mod envs {
     env default {
        SYS = "sys" ;
        SYS_MODEL = "arm-mac14-host";
        MODULE_ENV = "default";
     }
}
mod main : sys_ops {

    #[auto_load(entry)]
    flow __into_main {
        if defined(${GXL_CMD_ARG}) && ${GXL_CMD_ARG} != "" {
            MOD_NAME = ${GXL_CMD_ARG} ;
        }
    }
}