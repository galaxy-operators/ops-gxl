mod mod_ops {
    #[auto_load(entry)]
    flow __into_mod_ops  {
      //进行依赖确认
    }

  flow download {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "download" ) ;
  }
  flow install {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "install" ) ;
  }
  flow start {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "start" ) ;
   }
  flow stop {
    gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "stop" ) ;
  }
  flow restart {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "restart" ) ;
   }
  flow update {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "update" ) ;
   }
   flow uninstall {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "uninstall" ) ;
   }
   flow status {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "status" ) ;
   }
   flow diagnose {
      gx.run ( local : "./mod/${ENV_MODEL}", env : "${ENV_MODULE_ENV}" , flow : "diagnose" ) ;
   }
}

mod empty_operators  {

    #[task(name="download")]
    flow download {
        gx.echo ( "download need Todo....") ;
    }
    #[task(name="install")]
    flow install {
        gx.echo ( "install need Todo....") ;
    }

    #[task(name="uninstall")]
    flow uninstall {
        gx.echo ( "uninstall ignore Todo....") ;
    }
    #[task(name="update")]
    flow update {
        gx.echo ( "update ignore Todo....") ;
    }
    #[task(name="start")]
    flow start {
        gx.echo ( "start ignore ...") ;

    }
    #[task(name="stop")]
    flow stop {
        gx.echo ( "stop ignore ...") ;

    }
    #[task(name="restart")]
    flow restart {
        gx.echo ( "restart ignore ...") ;
    }
    #[task(name="status")]
    flow status {
        gx.echo ( "status ignore ...") ;
    }
    #[task(name="diagnose")]
    flow diagnose {
        gx.echo ( "diagnose ignore ...") ;
    }
}